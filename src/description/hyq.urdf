  <!-- Joint -->
  <joint name="trunk_imu_joint" type="fixed">
    <origin rpy="0.0 -3.14159265359 0.0" xyz="0.00485 0 0.0045"/>
    <parent link="trunk_imu_mount"/>
    <child link="trunk_imu"/>
  </joint>
  <joint name="trunk_imu_mount_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.27025 0.000 0.0967678"/>
    <parent link="trunk"/>
    <child link="trunk_imu_mount"/>
  </joint>
  <link name="trunk_imu_mount">
    <inertial>
      <origin xyz="-0.00020  0.00010  0.00110"/>
      <mass value="0.001"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.00555"/>
      <geometry>
        <box size="0.0329 0.0244 0.0111"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 0.9"/>
      </material>
    </visual>
  </link>
  <!-- Link -->
  <link name="trunk_imu">
    <inertial>
      <origin xyz="0.0  0.0  0.0"/>
      <mass value="0.001"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.0005"/>
      </geometry>
    </visual>
  </link>
  <gazebo>
    <plugin filename="libgazebo_ros_imu.so" name="trunk_imu_controller">
      <alwaysOn>true</alwaysOn>
      <updateRate>250</updateRate>
      <bodyName>trunk_imu</bodyName>
      <topicName>trunk_imu_1/data</topicName>
      <gaussianNoise>4e-08</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rpyOffset>0 0 0</rpyOffset>
      <serviceName>/trunk_imu</serviceName>
      <frameName>trunk_imu</frameName>
    </plugin>
  </gazebo>
  <!-- Imu definition required for DLS hardware interface of ros control -->
  <gazebo reference="trunk_imu">
    <sensor name="trunk_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>250</update_rate>
      <imu>
        <noise>
          <type>gaussian</type>
          <rate>
            <mean>0</mean>
            <stddev>0.0002</stddev>
            <bias_mean>0.00087</bias_mean>
            <bias_stddev>8e-07</bias_stddev>
          </rate>
          <accel>
            <mean>0</mean>
            <stddev>0.017</stddev>
            <bias_mean>0.002</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </accel>
        </noise>
      </imu>
    </sensor>
  </gazebo>
  <!-- IMU trunk -->
  <!-- TODO We have to substitute the microstrain IMU with this one. Note that the imu_name has to be
                  trunk_imu because the DLS HW interfaces hardcoded that name -->
  <!-- Joint connecting the mount point of the IMU to the robot -->
  <joint name="trunk_imu2_mount_joint" type="fixed">
    <origin rpy="0 3.14159265359 0.785398163397" xyz="0.316115 0.00 0.0887678"/>
    <parent link="trunk"/>
    <child link="trunk_imu2_mount"/>
  </joint>
  <!-- Fake joint connecting the mount point of the IMU to the
                     average sensing frame of the IMU -->
  <joint name="trunk_imu2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.017066667 -0.013 0.038366667"/>
    <parent link="trunk_imu2_mount"/>
    <child link="trunk_imu2"/>
  </joint>
  <!-- Fake joint connecting the mount point of the IMU to
                     the sensing point for the x-axis -->
  <joint name="trunk_imu2_sensing_point_x_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.0263 0.0336"/>
    <parent link="trunk_imu2_mount"/>
    <child link="trunk_imu2_sensing_point_x"/>
  </joint>
  <!-- Fake joint connecting the mount point of the IMU to
                     the sensing point for the x-axis -->
  <joint name="trunk_imu2_sensing_point_y_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.0256 -0.0121 0.0372"/>
    <parent link="trunk_imu2_mount"/>
    <child link="trunk_imu2_sensing_point_y"/>
  </joint>
  <!-- Fake joint connecting the mount point of the IMU to
                the sensing point for the x-axis -->
  <joint name="trunk_imu2_sensing_point_z_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.0256 -0.0006 0.0443"/>
    <parent link="trunk_imu2_mount"/>
    <child link="trunk_imu2_sensing_point_z"/>
  </joint>
  <!-- Fake link expressing the average sensing reference frame -->
  <link name="trunk_imu2">
    <inertial>
      <mass value="0.000"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00" ixy="0.0" ixz="0.0" iyy="0.00" iyz="0.0" izz="0.00"/>
    </inertial>
    <visual>
      <!-- fake visual to let URDF parser happy -->
      <geometry>
        <sphere radius="0.0005"/>
      </geometry>
    </visual>
  </link>
  <!-- Fake link exactly located at the sensing point for the x-axis -->
  <link name="trunk_imu2_sensing_point_x">
    <inertial>
      <mass value="0.000"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00" ixy="0.0" ixz="0.0" iyy="0.00" iyz="0.0" izz="0.00"/>
    </inertial>
    <visual>
      <!-- fake visual to let URDF parser happy -->
      <geometry>
        <sphere radius="0.0005"/>
      </geometry>
    </visual>
  </link>
  <!-- Fake link expressing the exact sensing point for the y-axis -->
  <link name="trunk_imu2_sensing_point_y">
    <inertial>
      <mass value="0.000"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00" ixy="0.0" ixz="0.0" iyy="0.00" iyz="0.0" izz="0.00"/>
    </inertial>
    <visual>
