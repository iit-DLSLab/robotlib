      <geometry>
        <sphere radius="0.0005"/>
      </geometry>
    </visual>
  </link>
  <!-- Fake link expressing the exact sensing point for the z-axis -->
  <link name="trunk_imu2_sensing_point_z">
    <inertial>
      <mass value="0.000"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00" ixy="0.0" ixz="0.0" iyy="0.00" iyz="0.0" izz="0.00"/>
    </inertial>
    <visual>
      <!-- fake visual to let URDF parser happy -->
      <geometry>
        <sphere radius="0.0005"/>
      </geometry>
    </visual>
  </link>
  <!-- Link -->
  <link name="trunk_imu2_mount">
    <inertial>
      <!-- CoM from technical document, rotated by pi/4 -->
      <origin xyz="-0.001697056  -0.001414214  0.0328"/>
      <mass value="0.69"/>
      <!-- izz = 0.5 * 0.69 * (88.9 / 2 / 1000)^2 -->
      <!-- ixx = iyy = 1/12*0.69*(3*(88.9/2000)^2+(73.7/1000)^2) -->
      <inertia ixx="0.000653148" ixy="0.0" ixz="0.0" iyy="0.000653148" iyz="0.0" izz="0.000681652"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://sensors_description/meshes/sensors/kvh_1775.dae" scale="1 1 1"/>
      </geometry>
      <material name="aluminium">
        <color rgba="0.35 0.35 0.35 1"/>
      </material>
    </visual>
  </link>
  <gazebo>
    <plugin filename="libgazebo_ros_imu.so" name="trunk_imu2_controller">
      <alwaysOn>true</alwaysOn>
      <updateRate>250</updateRate>
      <bodyName>trunk_imu2</bodyName>
      <topicName>trunk_imu_2/data</topicName>
      <gaussianNoise>4e-08</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rpyOffset>0 0 0</rpyOffset>
      <serviceName>/trunk_imu2</serviceName>
      <frameName>trunk_imu2</frameName>
    </plugin>
  </gazebo>
  <!-- Imu definition required for DLS hardware interface of ros control -->
  <gazebo reference="trunk_imu2">
    <sensor name="trunk_imu2" type="imu">
      <always_on>1</always_on>
      <update_rate>250</update_rate>
      <imu>
        <noise>
          <type>gaussian</type>
          <rate>
            <mean>0</mean>
            <stddev>0.0002</stddev>
            <bias_mean>0.00087</bias_mean>
            <bias_stddev>8e-07</bias_stddev>
          </rate>
          <accel>
            <mean>0</mean>
            <stddev>0.017</stddev>
            <bias_mean>0.002</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </accel>
        </noise>
      </imu>
    </sensor>
  </gazebo>
  <!-- Hokuyo -->
  <!--xacro:hokuyo_laser
		name="laser"
		parent="trunk"
		ros_topic="scan" 
		update_rate="10" 
		min_angle="-5"
		max_angle="5"
